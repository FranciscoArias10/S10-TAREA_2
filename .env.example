# Puerto del servidor HTTP
PORT=3000

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Configuración de PostgreSQL estándar (para usar con PostgreSQL local o en la nube)
# Si USE_EMBEDDED_PG=false, se utilizará esta cadena de conexión con el driver pg (Pool)
DATABASE_URL=postgresql://usuario:password@localhost:5432/catalogo_db
DB_SSL=false

# Motor PostgreSQL embebido persistente en disco (@electric-sql/pglite)
# Útil para ejecutar pruebas reproducibles sin instalar servicios externos
USE_EMBEDDED_PG=true
PG_DATA_DIR=./.pgdata

# Configuración de JSON Web Token (JWT)
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_SEGURO
JWT_EXPIRES_IN=2h

# Credenciales del usuario administrador inicial (script db:init)
ADMIN_NOMBRE=Administrador Principal
ADMIN_CORREO=admin@catalogo.local
ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_ADMIN

