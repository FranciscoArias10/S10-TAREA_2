        {
          "name": "1.7 Login con credenciales incorrectas (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechazo de credenciales incorrectas con 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('No entrega token', function () {",
                  "    pm.expect(data).to.not.have.property('token');",
