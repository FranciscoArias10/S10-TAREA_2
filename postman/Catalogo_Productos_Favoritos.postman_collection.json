        {
          "name": "1.4 Login Administrador (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Emite JWT y rol admin sin contraseña', function () {",
                  "    pm.expect(data.token).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(data.usuario.rol).to.eql('admin');",
                  "    pm.expect(data.usuario).to.not.have.property('password_hash');",
                  "    pm.environment.set('adminToken', data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{adminCorreo}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
