    {
      "name": "2. Catálogo Público y CRUD Admin",
      "item": [
        {
          "name": "2.1 Listar productos público (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Catálogo tiene al menos 5 productos', function () {",
                  "    pm.expect(data.productos).to.be.an('array');",
                  "    pm.expect(data.productos.length).to.be.at.least(5);",
                  "    pm.environment.set('productoSecundarioId', String(data.productos[0].id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "2.2 Filtrar productos por categoría (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Todos los productos filtrados pertenecen a Electrónica', function () {",
                  "    pm.expect(data.productos).to.be.an('array').and.not.be.empty;",
                  "    data.productos.forEach(p => pm.expect(p.categoria).to.eql('Electrónica'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos?categoria=Electrónica",
              "host": ["{{baseUrl}}"],
              "path": ["productos"],
              "query": [
                { "key": "categoria", "value": "Electrónica" }
              ]
            }
          }
        },
        {
          "name": "2.3 Consultar producto por ID (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Retorna detalle del producto', function () {",
                  "    pm.expect(data.producto).to.be.an('object');",
                  "    pm.expect(data.producto.precio).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{productoSecundarioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{productoSecundarioId}}"]
            }
          }
        },
        {
          "name": "2.4 Crear producto como Admin (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Producto creado correctamente', function () {",
                  "    pm.expect(data.producto.nombre).to.eql('Tablet Gráfica Pro');",
                  "    pm.expect(data.producto.precio).to.eql(249.5);",
                  "    pm.environment.set('productoCreadoId', String(data.producto.id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tablet Gráfica Pro\",\n  \"descripcion\": \"Tableta digitalizadora de alta precisión con lápiz sin batería.\",\n  \"categoria\": \"Diseño\",\n  \"precio\": 249.50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "2.5 Actualizar producto como Admin (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Producto actualizado con nuevo precio', function () {",
                  "    pm.expect(data.producto.nombre).to.eql('Tablet Gráfica Pro V2');",
                  "    pm.expect(data.producto.precio).to.eql(275);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tablet Gráfica Pro V2\",\n  \"descripcion\": \"Tableta digitalizadora actualizada con 8192 niveles de presión.\",\n  \"categoria\": \"Diseño\",\n  \"precio\": 275.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos/{{productoCreadoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{productoCreadoId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Validaciones de Datos y Errores",
      "item": [
        {
          "name": "3.1 Rechazo precio inválido <= 0 (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Informa error de precio', function () {",
                  "    pm.expect(data).to.have.property('error');",
                  "    pm.expect(data.errores).to.be.an('array').and.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto Precio Negativo\",\n  \"descripcion\": \"Prueba de validación de precio\",\n  \"categoria\": \"Electrónica\",\n  \"precio\": -15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "3.2 Rechazo campos vacíos en producto (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Reporta múltiples errores de campos obligatorios', function () {",
                  "    pm.expect(data.errores).to.be.an('array');",
                  "    pm.expect(data.errores.length).to.be.at.least(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"descripcion\": \"\",\n  \"categoria\": \"\",\n  \"precio\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "3.3 Consulta de producto inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/99999",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "99999"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Seguridad JWT (401) y Roles (403)",
      "item": [
        {
          "name": "4.1 Acceso protegido sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 401 Unauthorized sin token', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/favoritos",
              "host": ["{{baseUrl}}"],
              "path": ["favoritos"]
            }
          }
        },
        {
          "name": "4.2 Acceso protegido con token vencido (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 401 Unauthorized con token expirado', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Indica token expirado', function () {",
                  "    pm.expect(data.error).to.eql('Token expirado');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{expiredToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/favoritos",
              "host": ["{{baseUrl}}"],
              "path": ["favoritos"]
            }
          }
        },
        {
          "name": "4.3 Usuario normal intenta crear producto (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 403 Forbidden para rol usuario', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userAToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Intento No Autorizado\",\n  \"descripcion\": \"Usuario normal no debe poder crear\",\n  \"categoria\": \"Electrónica\",\n  \"precio\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "4.4 Usuario normal intenta actualizar producto (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 403 Forbidden para rol usuario', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userAToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cambio Indebido\",\n  \"descripcion\": \"Usuario normal no debe actualizar\",\n  \"categoria\": \"Electrónica\",\n  \"precio\": 99\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos/{{productoCreadoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{productoCreadoId}}"]
            }
          }
        },
        {
          "name": "4.5 Usuario normal intenta eliminar producto (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 403 Forbidden para rol usuario', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
