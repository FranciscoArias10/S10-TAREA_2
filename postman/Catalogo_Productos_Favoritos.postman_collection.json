            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Prueba B\",\n  \"correo\": \"usuario.b@ejemplo.local\",\n  \"password\": \"ClavePrueba123\",\n  \"rol\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "registro"]
            }
          }
        },
        {
          "name": "1.3 Registro con correo duplicado (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechazo de correo duplicado con 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Mensaje claro de error', function () {",
                  "    pm.expect(data).to.have.property('error');",
                  "    pm.expect(data).to.have.property('mensaje');",
                  "});"
                ]
