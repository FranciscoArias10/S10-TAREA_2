{
  "info": {
    "_postman_id": "a7f24c10-4b2f-4d91-8a11-7e94c8a22026",
    "name": "Catálogo de Productos y Favoritos (RBAC + JWT)",
    "description": "Colección reproducible de pruebas obligatorias para la API REST con Node.js, Express, PostgreSQL y JWT.\n\nAntes de ejecutar la carpeta 1, configure en el entorno local `adminCorreo` y `adminPassword` según su archivo `.env`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación y Registro",
      "item": [
        {
          "name": "1.1 Registro Usuario A (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Usuario creado con rol usuario y sin exponer contraseña', function () {",
                  "    pm.expect(data.usuario).to.be.an('object');",
                  "    pm.expect(data.usuario.rol).to.eql('usuario');",
                  "    pm.expect(data.usuario).to.not.have.property('password');",
                  "    pm.expect(data.usuario).to.not.have.property('password_hash');",
                  "    pm.environment.set('usuarioAId', String(data.usuario.id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Prueba A\",\n  \"correo\": \"usuario.a@ejemplo.local\",\n  \"password\": \"ClavePrueba123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "registro"]
            }
          }
        },
        {
          "name": "1.2 Registro Usuario B intentando rol admin (201 rol usuario)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('El servidor ignora rol admin en registro público y asigna usuario', function () {",
                  "    pm.expect(data.usuario.rol).to.eql('usuario');",
                  "    pm.expect(data.usuario).to.not.have.property('password_hash');",
                  "    pm.environment.set('usuarioBId', String(data.usuario.id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
