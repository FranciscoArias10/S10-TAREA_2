              "raw": "{\n  \"nombre\": \"Usuario Duplicado\",\n  \"correo\": \"usuario.a@ejemplo.local\",\n  \"password\": \"ClavePrueba123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "registro"]
            }
          }
